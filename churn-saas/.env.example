# .env.example

# PostgreSQL (lu par Docker Compose, à la racine)
POSTGRES_USER=churnsight
POSTGRES_PASSWORD=change_me
POSTGRES_DB=churnsight_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql://churnsight:change_me@localhost:5433/churnsight_db

# Backend
SECRET_KEY=colle_ici_la_cle_genere
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ML (chemin depuis le dossier backend/)
MODEL_PATH=../ml/models/random_forest_churn.pkl
RISK_THRESHOLD_HIGH=0.7
RISK_THRESHOLD_MEDIUM=0.4

# CORS
CORS_ORIGINS=http://localhost:3000

# --- Plus tard, si alertes par e-mail ---
